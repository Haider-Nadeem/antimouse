{
  "manifest_version": 3,
  "name": "antimouse",
  "version": "0.1.0",
  "description": "Spotlight-style search bar that traverses the current page.",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/page-links.js",
        "src/settings.js",
        "src/search.js",
        "src/overlay.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
