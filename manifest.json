{
  "manifest_version": 3,
  "name": "antimouse",
  "version": "1.0.0",
  "description": "Spotlight-style search bar that traverses the current page.",
  "author": "Haider Mirza",
  "homepage_url": "https://github.com/Haider-Nadeem/antimouse",
  "icons": {
    "16": "icons/icon-16.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_title": "antimouse — press Cmd+K / Ctrl+K to search the page",
    "default_icon": {
      "16": "icons/icon-16.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "permissions": ["storage"],
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": [
        "src/page-links.js",
        "src/settings-store.js",
        "src/settings.js",
        "src/search.js",
        "src/overlay.js",
        "src/main.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": ["styles.css"],
      "matches": ["<all_urls>"]
    }
  ]
}
